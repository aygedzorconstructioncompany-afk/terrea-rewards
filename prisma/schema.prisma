model Wallet {
  id          String   @id @default(cuid())
  customerId  String   @unique
  balance     Int      @default(0)
  createdAt   DateTime @default(now())

  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(cuid())
  walletId    String
  amount      Int
  type        String   // "earn" | "spend"
  description String?
  createdAt   DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])
}
